{
  "name": "@cloudseed/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "test:pg": "cross-env TEST_DB=postgres vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/lib-storage": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "fastify": "^5.0.0",
    "jose": "^6.0.0",
    "nodemailer": "^10.3.1",
    "parse-torrent": "^11.0.24",
    "pg": "^8.13.0",
    "pino": "^10.0.0",
    "webtorrent": "^3.0.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@fastify/busboy": "^3.2.4",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "@types/smtp-server": "^3.5.13",
    "cross-env": "^10.1.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "fflate": "^0.8.3",
    "s3rver": "^3.7.1",
    "smtp-server": "^3.21.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
