{
  "name": "CloudSeed",
  "short_name": "CloudSeed",
  "description": "Your own cloud for files, downloads and media.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8f9fb",
  "theme_color": "#4f46e5",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My Files", "url": "/files", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Downloads", "url": "/downloads", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
