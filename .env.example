# Copy to .env and fill in. Never commit .env.

# --- Application ---
# Public URL users type in the browser. Must be https:// in production.
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080
LOG_LEVEL=info

# --- Database (docker compose builds DATABASE_URL from these) ---
POSTGRES_USER=cloudseed
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cloudseed

# --- Google OAuth (see README: "Google sign-in setup") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
# Comma-separated; these emails become administrators on first verified sign-in.
ADMIN_EMAILS=
# open | closed  (closed: only ADMIN_EMAILS can register)
REGISTRATION_POLICY=open
AUTH_RATE_LIMIT_PER_MIN=20

# --- Sessions ---
# Generate with: openssl rand -base64 48   (>= 32 chars, required in production)
SESSION_SECRET=
SESSION_TTL_HOURS=336
# Encrypts stored credentials (Telegram bot tokens). Required in production: openssl rand -base64 32
# Back it up with the database: without it the stored tokens cannot be decrypted (bots must be reconnected).
ENCRYPTION_KEY=
# Requests per minute per client IP for the whole API (raise it behind a shared proxy/NAT)
RATE_LIMIT_PER_MIN=600
# Defaults to true in production, false otherwise.
# COOKIE_SECURE=true

# --- Storage ---
# local | s3. New files go to this backend; files already stored on the other one stay readable
# as long as that backend is still configured (S3 settings below can stay set when switching to local).
STORAGE_BACKEND=local
# S3-compatible (AWS S3, DigitalOcean Spaces, MinIO, Cloudflare R2, ...). Keep the bucket PRIVATE.
# DigitalOcean Spaces: S3_ENDPOINT=https://nyc3.digitaloceanspaces.com  S3_REGION=nyc3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and some other providers
S3_FORCE_PATH_STYLE=false
# Optional prefix inside the bucket, e.g. cloudseed
S3_KEY_PREFIX=
# Days before trashed items are deleted permanently. 0 = keep until emptied manually.
TRASH_RETENTION_DAYS=30
# Inside Docker these default to the /data volume; override only for non-Docker runs.
# LOCAL_STORAGE_ROOT=./data/storage
# LOCAL_TMP_DIR=./data/tmp
DEFAULT_USER_QUOTA_BYTES=5368709120
MAX_FILE_SIZE_BYTES=2147483648

# --- Downloads (worker) ---
# Jobs running at once across ALL workers / per user / per worker process.
DOWNLOAD_GLOBAL_CONCURRENCY=4
DOWNLOAD_USER_CONCURRENCY=2
WORKER_CONCURRENCY=2
# Per-job speed cap in bytes/second (0 = unlimited), e.g. 5242880 for 5 MiB/s
DOWNLOAD_BANDWIDTH_LIMIT_BPS=0
# Automatic retries (exponential backoff with jitter) before a job is marked failed
DOWNLOAD_MAX_ATTEMPTS=5
DOWNLOAD_BACKOFF_BASE_MS=5000
DOWNLOAD_BACKOFF_MAX_MS=600000
DOWNLOAD_IDLE_TIMEOUT_MS=30000
DOWNLOAD_CONNECT_TIMEOUT_MS=15000
DOWNLOAD_MAX_REDIRECTS=5
# Unfinished downloads one user may have queued (backpressure)
DOWNLOAD_MAX_ACTIVE_PER_USER=100
# Days finished job records are kept; hours an abandoned partial file is kept
DOWNLOAD_JOB_RETENTION_DAYS=14
DOWNLOAD_TMP_RETENTION_HOURS=24
# Seconds a worker may go silent before its jobs are handed to another worker
DOWNLOAD_LEASE_SECONDS=60
# SSRF policy. Private, loopback, link-local and cloud-metadata addresses are ALWAYS blocked unless listed here.
# Only add networks you intend users to fetch from (e.g. an internal mirror): DOWNLOAD_ALLOWED_CIDRS=10.20.0.0/16
DOWNLOAD_ALLOWED_CIDRS=
DOWNLOAD_ALLOWED_PORTS=80,443
# Max Postgres connections per process (API and worker each have a pool)
DB_POOL_MAX=10

# --- Telegram ---
TELEGRAM_ENABLED=true
# hosted = official api.telegram.org (files up to 50 MB, photos up to 10 MB)
# self-hosted = your own telegram-bot-api server (files up to 2000 MB); see compose profile telegram-local
TELEGRAM_API_MODE=hosted
TELEGRAM_API_BASE=https://api.telegram.org
# Only for the telegram-local profile (from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Minimum gap between sends into one chat; Telegram allows roughly 20 messages per minute per group
TELEGRAM_CHAT_INTERVAL_MS=3000
# Units sent at once (different chats) per worker
TELEGRAM_CONCURRENCY=2
# Automatic retries for connection problems (never for unknown-delivery sends)
TELEGRAM_MAX_ATTEMPTS=5
# Override the per-file limit only if your self-hosted server is configured differently
# TELEGRAM_MAX_UPLOAD_BYTES=

# --- Media library ---
# FFmpeg ships in the Docker image. For a non-Docker run, install it or point these at the binaries.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
MEDIA_ENABLED=true
# Files probed/thumbnailed at once by each worker
MEDIA_CONCURRENCY=1
# Converting to browser-friendly MP4/AAC is CPU heavy, so it is off by default
MEDIA_TRANSCODING_ENABLED=false
MEDIA_TRANSCODE_CONCURRENCY=1
MEDIA_THUMBNAIL_WIDTH=320

# --- Sharing ---
SHARING_ENABLED=true
# Longest lifetime a link can be given (links always expire)
SHARING_MAX_DAYS=365
SHARING_MAX_ACTIVE_PER_USER=100
# Password attempts per minute per address and link
SHARE_UNLOCK_RATE_PER_MIN=10

# --- Email notifications (optional) ---
# Leave SMTP_HOST empty to turn email off; in-app notifications always work.
SMTP_HOST=
SMTP_PORT=587
# true = TLS from the first byte (port 465). false = STARTTLS (port 587).
SMTP_SECURE=false
# Refuse to send, and never send the password, over an unencrypted connection
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CloudSeed <noreply@example.com>
EMAIL_MAX_PER_HOUR=20
NOTIFICATION_RETENTION_DAYS=90
# Warn (in the app, and by email if enabled) when a user has used this percentage of their quota
QUOTA_WARNING_PERCENT=90

# --- Monitoring ---
# Enables GET /api/v1/metrics (Prometheus format) for requests carrying "Authorization: Bearer <this token>". 16+ characters.
# The bundled nginx hides it from the internet; point Prometheus at api:8080 inside the Docker network.
METRICS_TOKEN=

# --- Scheduled backups (made by the worker) ---
# Make an encrypted, verified backup every N hours. 0 = off (an administrator can still press "Back up now" once a passphrase is set).
BACKUP_INTERVAL_HOURS=0
# How many verified backups to keep; older files are deleted. Files go to the "backups" volume (/backups in the containers).
BACKUP_KEEP=7
BACKUP_INCLUDE_OBJECTS=true
# 12+ characters. A backup cannot be read without it, and it is not stored anywhere else. Set ONE of these:
# BACKUP_PASSPHRASE=
# BACKUP_PASSPHRASE_FILE=/run/secrets/backup_passphrase
# Copy the backup files off the machine (rsync, rclone, a second disk). A backup next to the data it protects is not a backup.

# --- Backups by hand (the `cli` tool) ---
# 12+ characters. Keep it somewhere other than the backups themselves; a backup cannot be read without it.
# Deliberately NOT set here, because every container reads .env. Pass it only to the one-off command:
#   BACKUP_PASSPHRASE='...' docker compose --profile tools run --rm -e BACKUP_PASSPHRASE cli backup --out /backups/cloudseed.csbk
# BACKUP_PASSPHRASE=
